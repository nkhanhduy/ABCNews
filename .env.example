# ==============================================================================
# ABCNews - File cấu hình môi trường mẫu (.env.example)
# ==============================================================================
# Hướng dẫn sử dụng:
# 1. Sao chép (copy) file này thành ".env" tại thư mục gốc của dự án:
#    cp .env.example .env
# 2. Cập nhật các thông số mật khẩu và thông tin cấu hình cho môi trường local của bạn.
# 3. File ".env" đã được khai báo trong .gitignore và không được commit lên Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cấu hình Cơ sở dữ liệu (Microsoft SQL Server 2022)
# ------------------------------------------------------------------------------
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=ABCNews
DB_USER=sa
# Mật khẩu SA mẫu cho môi trường phát triển local (Ví dụ: ChangeMe_123!)
DB_PASSWORD=ChangeMe_123!

# ------------------------------------------------------------------------------
# 2. Cấu hình Ứng dụng Web (Tomcat & Java 17)
# ------------------------------------------------------------------------------
APP_PORT=8088
APP_BASE_URL=http://localhost:8088

# ------------------------------------------------------------------------------
# 3. Cấu hình Email SMTP (Google Gmail) - Tùy chọn cho OTP & Newsletter
# ------------------------------------------------------------------------------
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=your_email@gmail.com
MAIL_SMTP_PASSWORD=your_gmail_app_password

# ------------------------------------------------------------------------------
# 4. Cấu hình Google OAuth 2.0 (Google Sign-In) - Tùy chọn
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
